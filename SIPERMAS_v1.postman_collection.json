			"name": "1. Authentication",
			"item": [
				{
					"name": "Login - Warga (Ahmad)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var extractedToken = jsonData.token || jsonData.access_token || jsonData.plainTextToken || (jsonData.data && (jsonData.data.token || jsonData.data.access_token || jsonData.data.plainTextToken));",
									"if (extractedToken) {",
									"    pm.collectionVariables.set(\"token\", extractedToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"ahmad@gmail.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
